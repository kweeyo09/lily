# Only needed if you run the Express/tRPC server (`pnpm dev` / `pnpm start`).
# The static portfolio build (`vite build` -> dist/public) needs none of these.

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# MySQL connection string for the `users` table. Leave blank to run without a DB.
DATABASE_URL=

# openId of the account that should be granted the `admin` role on upsert.
OWNER_OPEN_ID=
